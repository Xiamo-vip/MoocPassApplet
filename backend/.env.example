# 基础服务配置
PORT=8088

# 数据库配置
MOOC_DB_URL=jdbc:mysql://localhost:3306/moocpass?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf-8&allowPublicKeyRetrieval=true
MOOC_DB_USER=root
MOOC_DB_PASSWORD=your_database_password
MOOC_DB_POOL_SIZE=12

# 安全加密主密钥（32 字节 Base64 编码密钥）
MOOC_ENCRYPTION_KEY=v1:your_base64_encoded_32bytes_key_here=

# 微信小程序配置
MOOC_WX_APP_ID=your_wechat_app_id
MOOC_WX_APP_SECRET=your_wechat_app_secret

# 平台网络代理配置（可选，如需通过 HTTP / SOCKS 代理访问平台则配置）
MOOC_PROXY_ENABLED=false
MOOC_PROXY_TYPE=http
MOOC_PROXY_HOST=
MOOC_PROXY_PORT=0
MOOC_PROXY_USERNAME=
MOOC_PROXY_PASSWORD=
MOOC_PROXY_APPLY_OUTBOUND=false

# 平台开关
MOOC_CHAOXING_ENABLED=true
MOOC_ZHY_ENABLED=true

# 任务并发与槽位配置
MOOC_WORKER_SLOTS=4
MOOC_GLOBAL_SLOTS=30
MOOC_USER_SLOTS=2
